# Every value here is optional. With none of them set the feed serves the
# deterministic generator and the dashboard runs with no accounts and no keys.

# --- quote source ---
# Set to use live Finnhub quotes instead of the generator (https://finnhub.io).
# FINNHUB_API_KEY=
# Force a source explicitly: synthetic | finnhub
# QUOTE_PROVIDER=synthetic
# Seed for the generator. A fixed seed replays the same session every time.
# FEED_SEED=20240695

# --- commentary source ---
# Set to have Claude write the one-line board summary. Without it the summary
# is produced by the deterministic arithmetic summariser.
# ANTHROPIC_API_KEY=
# COMMENTARY_PROVIDER=heuristic
# COMMENTARY_MODEL=claude-opus-5
# COMMENTARY_TTL_MS=60000

# --- feed process ---
# PORT=7202
# HOST=127.0.0.1
# POLL_INTERVAL_MS=2000
# HEARTBEAT_INTERVAL_MS=15000
# HISTORY_DEPTH=40

# --- compose only ---
# WEB_PORT=7201
